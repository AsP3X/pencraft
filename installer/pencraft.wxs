<?xml version="1.0" encoding="UTF-8"?>
<!--
  MSI installer for Quill. Built with the WiX Toolset (v4 or v5):

    wix build installer\pencraft.wxs -arch x64 -b installer ^
      -d Version=0.2.0 -d ExePath=app\target\release\pencraft.exe ^
      -o app\target\installer\pencraft-0.2.0-x64.msi

  installer\build.ps1 does this with the version from app\Cargo.toml.

  Installs for all users into Program Files, adds a Start menu shortcut and
  puts the folder on the system PATH, so AI clients can run `pencraft mcp`.
  A newer version replaces an older one.
  The UpgradeCode must never change: it is how Windows knows two versions
  are the same product.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Quill"
      Manufacturer="Quill"
      Version="$(var.Version)"
      UpgradeCode="8F4CDB5D-7FC3-4DF3-8A5D-7F5815112903"
      Scope="perMachine"
      Compressed="yes"
      InstallerVersion="500">

    <SummaryInformation Description="Canvas design editor for .pen files" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Quill is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- The app has no repair or change options: Programs and Features only
         offers Uninstall. -->
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- The icon in Programs and Features. The file is found through the
         bind path (-b installer). The shortcut shows the icon inside
         pencraft.exe, which is the same one (app\build.rs). -->
    <Icon Id="PencraftIcon.ico" SourceFile="pencraft.ico" />
    <Property Id="ARPPRODUCTICON" Value="PencraftIcon.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Pencraft">
        <Component Id="MainExecutable" Guid="*">
          <File Id="AppExe" Name="pencraft.exe" Source="$(var.ExePath)" KeyPath="yes" />
          <!-- So `pencraft mcp` works for any AI client. Removed on uninstall. -->
          <Environment
              Id="PathEntry"
              Name="PATH"
              Value="[INSTALLFOLDER]"
              Part="last"
              Action="set"
              System="yes"
              Permanent="no" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut
            Id="AppShortcut"
            Name="Quill"
            Description="Canvas design editor for .pen files"
            Target="[INSTALLFOLDER]pencraft.exe" />
        <RegistryValue
            Root="HKCU"
            Key="Software\Pencraft"
            Name="StartMenuShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Quill" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
