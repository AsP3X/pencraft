{
  "version": "2.22",
  "children": [
    {
      "type": "frame",
      "id": "ui-components",
      "x": -360,
      "y": 0,
      "name": "UI components",
      "layout": "vertical",
      "gap": 32,
      "padding": 32,
      "fill": "#e5e5e5",
      "children": [
        {
          "type": "frame",
          "id": "ui-button",
          "name": "Button",
          "reusable": true,
          "height": 36,
          "gap": 6,
          "padding": [
            0,
            10
          ],
          "justifyContent": "center",
          "alignItems": "center",
          "fill": "$primary",
          "cornerRadius": "$radius-md",
          "children": [
            {
              "type": "text",
              "id": "ui-button-label",
              "name": "Label",
              "fill": "$primary-foreground",
              "content": "Save changes",
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "500"
            }
          ]
        },
        {
          "type": "frame",
          "id": "ui-button-icon-leading",
          "name": "Button, leading icon",
          "reusable": true,
          "height": 36,
          "gap": 6,
          "padding": [
            0,
            10,
            0,
            8
          ],
          "justifyContent": "center",
          "alignItems": "center",
          "fill": "$primary",
          "cornerRadius": "$radius-md",
          "children": [
            {
              "type": "icon",
              "id": "ui-button-icon-leading-icon",
              "name": "Icon",
              "width": 16,
              "height": 16,
              "fill": "$primary-foreground",
              "library": "lucide",
              "icon": "plus"
            },
            {
              "type": "text",
              "id": "ui-button-icon-leading-label",
              "name": "Label",
              "fill": "$primary-foreground",
              "content": "New project",
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "500"
            }
          ]
        }
      ]
    },
    {
      "type": "frame",
      "id": "bs-light",
      "x": 0,
      "y": 0,
      "name": "Button states",
      "layout": "horizontal",
      "gap": 24,
      "padding": 32,
      "fill": "$background",
      "children": [
        {
          "type": "frame",
          "id": "bs-col-rest",
          "name": "Rest",
          "layout": "vertical",
          "gap": 16,
          "children": [
            {
              "type": "text",
              "id": "bs-col-rest-label",
              "name": "Column label",
              "fill": "$muted-foreground",
              "content": "Rest",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "500"
            },
            {
              "type": "ref",
              "id": "bs-primary-rest",
              "name": "Button / primary / rest",
              "ref": "ui-button",
