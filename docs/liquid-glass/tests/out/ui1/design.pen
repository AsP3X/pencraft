{
  "version": "2.22",
  "children": [
    {
      "type": "frame",
      "id": "ui-board",
      "x": 1400,
      "y": 0,
      "name": "UI components",
      "layout": "vertical",
      "gap": 32,
      "padding": 32,
      "fill": "#e5e5e5",
      "children": [
        {
          "type": "frame",
          "id": "ui-button",
          "name": "Button",
          "reusable": true,
          "height": 36,
          "gap": 6,
          "padding": [
            0,
            10
          ],
          "justifyContent": "center",
          "alignItems": "center",
          "fill": "$primary",
          "cornerRadius": "$radius-md",
          "children": [
            {
              "type": "text",
              "id": "ui-button-label",
              "name": "Label",
              "fill": "$primary-foreground",
              "content": "Save changes",
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "500"
            }
          ]
        },
        {
          "type": "frame",
          "id": "ui-input",
          "name": "Input",
          "reusable": true,
          "width": 280,
          "height": 36,
          "padding": [
            0,
            10
          ],
          "alignItems": "center",
          "fill": "$control",
          "stroke": "$input",
          "strokeWidth": 1,
          "strokeAlignment": "inner",
          "cornerRadius": "$radius-md",
          "children": [
            {
              "type": "text",
              "id": "ui-input-value",
              "name": "Value",
              "fill": "$muted-foreground",
              "content": "name@company.com",
              "fontFamily": "$font",
              "fontSize": 14
            }
          ]
        },
        {
          "type": "frame",
          "id": "ui-select",
          "name": "Select",
          "reusable": true,
          "width": 280,
          "height": 36,
          "gap": 6,
          "padding": [
            0,
            8,
            0,
            10
          ],
          "justifyContent": "space_between",
          "alignItems": "center",
          "fill": "$control",
          "stroke": "$input",
          "strokeWidth": 1,
          "strokeAlignment": "inner",
          "cornerRadius": "$radius-md",
          "children": [
            {
              "type": "text",
              "id": "ui-select-value",
              "name": "Value",
              "fill": "$foreground",
              "content": "Editor",
              "fontFamily": "$font",
              "fontSize": 14
            },
            {
              "type": "icon",
              "id": "ui-select-icon",
              "name": "Icon",
              "width": 16,
              "height": 16,
              "fill": "$muted-foreground",
              "library": "lucide",
              "icon": "chevron-down"
            }
          ]
        },
        {
          "type": "frame",
          "id": "ui-switch",
          "name": "Switch",
          "reusable": true,
          "gap": 8,
          "alignItems": "center",
          "children": [
            {
              "type": "frame",
              "id": "ui-switch-track",
              "name": "Track",
              "width": 32,
              "height": 18,
              "padding": 2,
              "justifyContent": "end",
              "alignItems": "center",
              "fill": "$primary",
              "cornerRadius": 9,
              "children": [
                {
                  "type": "ellipse",
                  "id": "ui-switch-thumb",
                  "name": "Thumb",
                  "width": 14,
                  "height": 14,
                  "fill": "$background"
                }
              ]
            },
            {
              "type": "text",
              "id": "ui-switch-label",
              "name": "Label",
              "fill": "$foreground",
              "content": "Email me a weekly summary",
              "fontFamily": "$font",
              "fontSize": 14
            }
          ]
        },
        {
          "type": "frame",
          "id": "ui-dialog",
          "name": "Dialog",
          "reusable": true,
          "width": 448,
          "layout": "vertical",
          "gap": 24,
          "padding": 24,
          "fill": "$popover",
          "stroke": "$hairline",
          "strokeWidth": 1,
          "strokeAlignment": "inner",
          "cornerRadius": "$radius-xl",
          "children": [
            {
              "type": "frame",
              "id": "ui-dialog-header",
              "name": "Header",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 8,
              "children": [
                {
                  "type": "frame",
                  "id": "ui-dialog-title-row",
                  "width": "fill_container",
                  "gap": 16,
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "text",
                      "id": "ui-dialog-title",
                      "name": "Title",
                      "width": "fill_container",
                      "fill": "$foreground",
                      "content": "Invite a teammate",
                      "textGrowth": "fixed-width",
                      "fontFamily": "$font",
                      "fontSize": 16,
                      "fontWeight": "500"
                    },
                    {
                      "type": "icon",
                      "id": "ui-dialog-close",
                      "name": "Close",
                      "width": 16,
                      "height": 16,
                      "fill": "$muted-foreground",
                      "library": "lucide",
                      "icon": "x"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "ui-dialog-description",
                  "name": "Description",
                  "width": "fill_container",
                  "fill": "$muted-foreground",
                  "content": "They can open the Harbour Rota workspace as soon as they accept.",
                  "textGrowth": "fixed-width",
                  "fontFamily": "$font",
                  "fontSize": 14,
                  "lineHeight": 1.45
                }
              ]
            },
            {
              "type": "frame",
              "id": "ui-dialog-body",
              "name": "Body",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 8,
              "children": [
                {
                  "type": "text",
                  "id": "ui-dialog-field-label",
                  "name": "Label",
                  "fill": "$foreground",
                  "content": "Work email",
                  "fontFamily": "$font",
                  "fontSize": 14,
                  "fontWeight": "500"
                },
                {
                  "type": "ref",
                  "id": "ui-dialog-field-control",
                  "width": "fill_container",
                  "ref": "ui-input"
                }
              ]
            },
            {
              "type": "frame",
              "id": "ui-dialog-footer",
              "name": "Footer",
              "width": "fill_container",
              "gap": 8,
              "justifyContent": "end",
              "children": [
                {
                  "type": "ref",
                  "id": "ui-dialog-cancel",
                  "fill": "$control",
                  "stroke": "$border",
                  "strokeWidth": 1,
                  "strokeAlignment": "inner",
                  "ref": "ui-button",
                  "descendants": {
                    "ui-button-label": {
                      "content": "Cancel",
                      "fill": "$foreground"
                    }
                  }
                },
                {
                  "type": "ref",
                  "id": "ui-dialog-confirm",
                  "ref": "ui-button",
                  "descendants": {
                    "ui-button-label": {
                      "content": "Send invite"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
