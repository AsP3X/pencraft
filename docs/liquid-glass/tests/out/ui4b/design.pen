{
  "version": "2.22",
  "children": [
    {
      "type": "frame",
      "id": "ui-board",
      "x": -854,
      "y": 0,
      "name": "UI components",
      "layout": "vertical",
      "gap": 32,
      "padding": 32,
      "fill": "#e5e5e5",
      "children": [
        {
          "type": "frame",
          "id": "ui-button",
          "name": "Button",
          "reusable": true,
          "height": 36,
          "gap": 6,
          "padding": [
            0,
            10
          ],
          "justifyContent": "center",
          "alignItems": "center",
          "fill": "$primary",
          "cornerRadius": "$radius-md",
          "children": [
            {
              "type": "text",
              "id": "ui-button-label",
              "name": "Label",
              "fill": "$primary-foreground",
              "content": "Save changes",
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "500"
            }
          ]
        },
        {
          "type": "frame",
          "id": "ui-select",
          "name": "Select",
          "reusable": true,
          "width": 280,
          "height": 36,
          "gap": 6,
          "padding": [
            0,
            8,
            0,
            10
          ],
          "justifyContent": "space_between",
          "alignItems": "center",
          "fill": "$control",
          "stroke": "$input",
          "strokeWidth": 1,
          "strokeAlignment": "inner",
          "cornerRadius": "$radius-md",
          "children": [
            {
              "type": "text",
              "id": "ui-select-value",
              "name": "Value",
              "fill": "$foreground",
              "content": "Editor",
              "fontFamily": "$font",
              "fontSize": 14
            },
            {
              "type": "icon",
              "id": "ui-select-icon",
              "name": "Icon",
              "width": 16,
              "height": 16,
              "fill": "$muted-foreground",
              "library": "lucide",
              "icon": "chevron-down"
            }
          ]
        },
        {
          "type": "frame",
          "id": "ui-textarea",
          "name": "Textarea",
          "reusable": true,
          "width": 280,
          "height": 80,
          "padding": [
            8,
            10
          ],
          "alignItems": "start",
          "fill": "$control",
          "stroke": "$input",
          "strokeWidth": 1,
          "strokeAlignment": "inner",
          "cornerRadius": "$radius-md",
          "children": [
            {
              "type": "text",
              "id": "ui-textarea-value",
              "name": "Value",
              "width": "fill_container",
              "fill": "$muted-foreground",
              "content": "Tell the team what changed and why.",
              "textGrowth": "fixed-width",
              "fontFamily": "$font",
              "fontSize": 14,
              "lineHeight": 1.45
            }
          ]
        },
        {
          "type": "frame",
          "id": "ui-list-row",
          "name": "List row",
          "reusable": true,
          "width": 390,
          "height": 64,
          "gap": 12,
          "padding": [
            0,
            16
          ],
          "alignItems": "center",
          "stroke": "$border",
          "strokeWidth": {
            "bottom": 1
          },
          "children": [
            {
              "type": "frame",
              "id": "ui-list-row-text",
              "name": "Text",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 2,
              "children": [
                {
                  "type": "text",
                  "id": "ui-list-row-title",
                  "name": "Title",
                  "fill": "$foreground",
                  "content": "Ferry desk",
                  "fontFamily": "$font",
                  "fontSize": 16,
                  "fontWeight": "500"
                },
                {
                  "type": "text",
                  "id": "ui-list-row-description",
                  "name": "Description",
                  "fill": "$muted-foreground",
                  "content": "Aksel Bjørnstad-Lie",
                  "fontFamily": "$font",
                  "fontSize": 14
                }
              ]
            },
            {
              "type": "text",
              "id": "ui-list-row-value",
              "name": "Value",
              "width": 112,
              "fill": "$foreground",
              "content": "10:00 to 18:00",
              "textGrowth": "fixed-width",
              "fontFamily": "$font",
              "fontSize": 14,
              "textAlign": "right"
            }
          ]
        },
        {
          "type": "frame",
          "id": "ui-drawer",
          "name": "Drawer",
          "reusable": true,
          "width": 390,
          "layout": "vertical",
          "padding": [
            16,
            0,
            0,
            0
          ],
          "alignItems": "center",
          "fill": "$popover",
          "cornerRadius": [
            14,
            14,
            0,
            0
          ],
          "children": [
            {
              "type": "rectangle",
              "id": "ui-drawer-handle",
              "name": "Handle",
              "width": 100,
              "height": 6,
              "fill": "$muted",
              "cornerRadius": 3
            },
            {
              "type": "frame",
              "id": "ui-drawer-header",
              "name": "Header",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 4,
              "padding": 16,
              "children": [
                {
                  "type": "text",
                  "id": "ui-drawer-title",
                  "name": "Title",
                  "fill": "$foreground",
                  "content": "Move to another shift",
                  "fontFamily": "$font",
                  "fontSize": 16,
                  "fontWeight": "500"
                },
                {
                  "type": "text",
                  "id": "ui-drawer-description",
                  "name": "Description",
                  "width": "fill_container",
                  "fill": "$muted-foreground",
                  "content": "Maren keeps her break at 12:30.",
                  "textGrowth": "fixed-width",
                  "fontFamily": "$font",
                  "fontSize": 14,
                  "lineHeight": 1.45
                }
              ]
            },
            {
              "type": "frame",
              "id": "ui-drawer-body",
              "name": "Body",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 24,
              "padding": [
                0,
                16
              ]
            },
            {
              "type": "frame",
              "id": "ui-drawer-footer",
              "name": "Footer",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 8,
              "padding": [
                8,
                16,
                24,
                16
              ],
              "children": [
                {
                  "type": "ref",
                  "id": "ui-drawer-confirm",
                  "width": "fill_container",
                  "height": 44,
                  "ref": "ui-button",
                  "descendants": {
                    "ui-button-label": {
                      "content": "Move shift"
                    }
                  }
                },
                {
                  "type": "ref",
                  "id": "ui-drawer-cancel",
                  "width": "fill_container",
                  "height": 44,
                  "fill": "$control",
                  "stroke": "$border",
                  "strokeWidth": 1,
                  "strokeAlignment": "inner",
                  "ref": "ui-button",
                  "descendants": {
                    "ui-button-label": {
                      "content": "Cancel",
                      "fill": "$foreground"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "ui-toast",
          "name": "Toast",
          "reusable": true,
          "width": 356,
          "gap": 8,
          "padding": 16,
          "alignItems": "center",
          "fill": "$popover",
          "stroke": "$hairline",
          "strokeWidth": 1,
          "strokeAlignment": "inner",
          "effect": [
            {
              "type": "shadow",
              "offset": {
                "x": 0,
                "y": 2
              },
              "blur": 6,
              "color": "#0000000f"
            },
            {
              "type": "shadow",
              "offset": {
                "x": 0,
                "y": 12
              },
              "blur": 28,
              "color": "#0000001f"
            }
          ],
          "cornerRadius": "$radius-lg",
          "children": [
            {
              "type": "icon",
              "id": "ui-toast-icon",
              "name": "Icon",
              "width": 16,
              "height": 16,
              "fill": "$foreground",
              "library": "lucide",
              "icon": "circle-check"
            },
            {
              "type": "frame",
              "id": "ui-toast-content",
              "name": "Content",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 2,
              "children": [
                {
                  "type": "text",
                  "id": "ui-toast-title",
                  "name": "Title",
                  "fill": "$foreground",
                  "content": "Invitation sent",
                  "fontFamily": "$font",
                  "fontSize": 13,
                  "fontWeight": "500"
                },
                {
                  "type": "text",
                  "id": "ui-toast-description",
                  "name": "Description",
                  "width": "fill_container",
                  "fill": "$muted-foreground",
                  "content": "Maren gets an email in a minute.",
                  "textGrowth": "fixed-width",
                  "fontFamily": "$font",
                  "fontSize": 13
                }
              ]
            },
            {
              "type": "frame",
              "id": "ui-toast-action",
              "name": "Action",
              "height": 24,
              "padding": [
                0,
                8
              ],
              "justifyContent": "center",
              "alignItems": "center",
              "fill": "$primary",
              "cornerRadius": "$radius-xs",
              "children": [
                {
                  "type": "text",
                  "id": "ui-toast-action-label",
                  "fill": "$primary-foreground",
                  "content": "Undo",
                  "fontFamily": "$font",
                  "fontSize": 12,
                  "fontWeight": "500"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "frame",
      "id": "screen",
      "x": 0,
      "y": 0,
      "name": "Today's shifts, swap drawer open",
      "theme": {
        "Mode": "Dark"
      },
      "width": 390,
      "height": 844,
      "clip": true,
      "layout": "none",
      "fill": "$background",
      "children": [
        {
          "type": "frame",
          "id": "page",
          "x": 0,
          "y": 0,
          "name": "Page",
          "width": 390,
          "height": 844,
          "layout": "vertical",
          "padding": [
            44,
            0,
            0,
            0
          ],
          "children": [
            {
              "type": "frame",
              "id": "page-header",
              "name": "Header",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 4,
              "padding": [
                16,
                16,
                16,
                16
              ],
              "children": [
                {
                  "type": "text",
                  "id": "page-title",
                  "name": "Title",
                  "fill": "$foreground",
                  "content": "Today's shifts",
                  "fontFamily": "$font",
                  "fontSize": 24,
                  "fontWeight": "500"
                },
                {
                  "type": "text",
                  "id": "page-date",
                  "name": "Description",
                  "fill": "$muted-foreground",
                  "content": "Saturday 14 November, Harbour terminal",
                  "fontFamily": "$font",
                  "fontSize": 14
                }
              ]
            },
            {
              "type": "frame",
              "id": "shift-list",
              "name": "Shifts",
              "width": "fill_container",
              "layout": "vertical",
              "children": [
                {
                  "type": "ref",
                  "id": "shift-1",
                  "name": "Shift / Ticket hall",
                  "width": "fill_container",
                  "ref": "ui-list-row",
                  "descendants": {
                    "ui-list-row-title": {
                      "content": "Ticket hall"
                    },
                    "ui-list-row-description": {
                      "content": "Ingrid Aasen-Vik"
                    },
                    "ui-list-row-value": {
                      "content": "06:00 to 14:00"
                    }
                  }
                },
                {
                  "type": "ref",
                  "id": "shift-2",
                  "name": "Shift / Ferry desk (chosen)",
                  "width": "fill_container",
                  "fill": "$muted",
                  "ref": "ui-list-row",
                  "descendants": {
                    "ui-list-row-title": {
                      "content": "Ferry desk"
                    },
                    "ui-list-row-description": {
                      "content": "You"
                    },
                    "ui-list-row-value": {
                      "content": "10:00 to 18:00"
                    }
                  }
                },
                {
                  "type": "ref",
                  "id": "shift-3",
                  "name": "Shift / Car deck",
                  "width": "fill_container",
                  "ref": "ui-list-row",
                  "descendants": {
                    "ui-list-row-title": {
                      "content": "Car deck"
                    },
                    "ui-list-row-description": {
                      "content": "Aksel Bjørnstad-Lie"
                    },
                    "ui-list-row-value": {
                      "content": "10:00 to 18:00"
                    }
                  }
                },
                {
                  "type": "ref",
                  "id": "shift-4",
                  "name": "Shift / Luggage room",
                  "width": "fill_container",
                  "ref": "ui-list-row",
                  "descendants": {
                    "ui-list-row-title": {
                      "content": "Luggage room"
                    },
                    "ui-list-row-description": {
                      "content": "Tobias Rønning"
                    },
                    "ui-list-row-value": {
                      "content": "12:30 to 17:00"
                    }
                  }
                },
                {
                  "type": "ref",
                  "id": "shift-5",
                  "name": "Shift / Gangway",
                  "width": "fill_container",
                  "ref": "ui-list-row",
                  "descendants": {
                    "ui-list-row-title": {
                      "content": "Gangway"
                    },
                    "ui-list-row-description": {
                      "content": "Maren Solheim"
                    },
                    "ui-list-row-value": {
                      "content": "14:00 to 22:00"
                    }
                  }
                },
                {
                  "type": "ref",
                  "id": "shift-6",
                  "name": "Shift / Ticket hall, late",
                  "width": "fill_container",
                  "ref": "ui-list-row",
                  "descendants": {
                    "ui-list-row-title": {
                      "content": "Ticket hall"
                    },
                    "ui-list-row-description": {
                      "content": "Jonas Halvorsen"
                    },
                    "ui-list-row-value": {
                      "content": "14:00 to 22:00"
                    }
                  }
                },
                {
                  "type": "ref",
                  "id": "shift-7",
                  "name": "Shift / Ferry desk, late",
                  "width": "fill_container",
                  "ref": "ui-list-row",
                  "descendants": {
                    "ui-list-row-title": {
                      "content": "Ferry desk"
                    },
                    "ui-list-row-description": {
                      "content": "Signe Dahl"
                    },
                    "ui-list-row-value": {
                      "content": "18:00 to 23:30"
                    }
                  }
                },
                {
                  "type": "ref",
                  "id": "shift-8",
                  "name": "Shift / Night watch",
                  "width": "fill_container",
                  "strokeWidth": {
                    "bottom": 0
                  },
                  "ref": "ui-list-row",
                  "descendants": {
                    "ui-list-row-title": {
                      "content": "Night watch"
                    },
                    "ui-list-row-description": {
                      "content": "Henrik Myklebust"
                    },
                    "ui-list-row-value": {
                      "content": "22:00 to 06:00"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "rectangle",
          "id": "scrim",
          "x": 0,
          "y": 0,
          "name": "Scrim",
          "width": 390,
          "height": 844,
          "fill": "$scrim"
        },
        {
          "type": "ref",
          "id": "swap-drawer",
          "x": 0,
          "y": 398,
          "name": "Swap shift drawer",
          "ref": "ui-drawer",
          "descendants": {
            "ui-drawer-title": {
              "content": "Swap your shift"
            },
            "ui-drawer-description": {
              "content": "Ferry desk, today 10:00 to 18:00."
            },
            "ui-drawer-body": {
              "padding": [
                8,
                16
              ],
              "children": [
                {
                  "type": "frame",
                  "id": "swap-field-teammate",
                  "name": "Field / Teammate",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "id": "swap-teammate-label",
                      "name": "Label",
                      "content": "Swap with",
                      "fontFamily": "$font",
                      "fontSize": 14,
                      "fontWeight": "500",
                      "fill": "$foreground"
                    },
                    {
                      "type": "ref",
                      "id": "swap-teammate-select",
                      "name": "Select / Teammate",
                      "ref": "ui-select",
                      "width": "fill_container",
                      "height": 44,
                      "padding": [
                        0,
                        12
                      ],
                      "descendants": {
                        "ui-select-value": {
                          "content": "Maren Solheim",
                          "fontSize": 16
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "swap-field-note",
                  "name": "Field / Note",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "id": "swap-note-label",
                      "name": "Label",
                      "content": "Note",
                      "fontFamily": "$font",
                      "fontSize": 14,
                      "fontWeight": "500",
                      "fill": "$foreground"
                    },
                    {
                      "type": "ref",
                      "id": "swap-note-textarea",
                      "name": "Textarea / Note",
                      "ref": "ui-textarea",
                      "width": "fill_container",
                      "padding": [
                        8,
                        12
                      ],
                      "descendants": {
                        "ui-textarea-value": {
                          "content": "Dentist at 15:00. I can take your gangway shift instead.",
                          "fontSize": 16,
                          "fill": "$foreground"
                        }
                      }
                    }
                  ]
                }
              ]
            },
            "ui-drawer-confirm": {
              "padding": [
                0,
                12
              ],
              "descendants": {
                "ui-button-label": {
                  "content": "Send swap request",
                  "fontSize": 16
                }
              }
            },
            "ui-drawer-cancel": {
              "padding": [
                0,
                12
              ],
              "descendants": {
                "ui-button-label": {
                  "content": "Cancel",
                  "fontSize": 16,
                  "fill": "$foreground"
                }
              }
            }
          }
        },
        {
          "type": "ref",
          "id": "swap-toast",
          "x": 16,
          "y": 52,
          "name": "Toast / Swap sent",
          "width": 358,
          "ref": "ui-toast",
          "descendants": {
            "ui-toast-title": {
              "content": "Swap request sent"
            },
            "ui-toast-description": {
              "content": "Jonas was asked to take your Thursday late shift."
            },
            "ui-toast-action": {
              "enabled": false
            }
          }
        }
      ]
    }
  ],
  "themes": {
    "Mode": [
      "Light",
      "Dark"
    ]
  },
  "variables": {
    "background": {
      "type": "color",
      "value": [
        {
          "value": "#ffffff"
        },
        {
          "value": "#0a0a0a",
          "theme": {
            "Mode": "Dark"
          }
        }
      ]
    },
    "foreground": {
      "type": "color",
      "value": [
        {
          "value": "#0a0a0a"
        },
        {
          "value": "#fafafa",
