{"description": "The loaf's night and this week's loaves", "operations": [{"op": "insert", "parent": "page", "node": {"type": "frame", "name": "How it is made: one loaf's night", "children": [{"type": "frame", "name": "Head", "children": [{"type": "text", "content": "Tuesday's loaf starts on Monday morning.", "fontFamily": "$font-display", "fontSize": 40, "fontWeight": "700", "fill": "$ink", "textGrowth": "fixed-width", "width": 520, "lineHeight": 1.1, "letterSpacing": -1, "name": "Heading"}, {"type": "text", "content": "Nothing is hurried along with baker's yeast. Eighteen hours pass between the first fold and the oven, which is why the crumb is sour and open, and still good on day four.", "fontFamily": "$font", "fontSize": 18, "fontWeight": "400", "fill": "$ink-soft", "textGrowth": "fixed-width", "width": 560, "lineHeight": 1.5}], "width": "fill_container", "justifyContent": "space_between", "alignItems": "end"}, {"type": "frame", "name": "Timetable", "children": [{"type": "frame", "name": "Stop", "children": [{"type": "text", "content": "Mon 09:00", "fontFamily": "$font-display", "fontSize": 28, "fontWeight": "700", "fill": "$ink", "letterSpacing": -0.5}, {"type": "frame", "name": "Rail", "children": [{"type": "ellipse", "width": 16, "height": 16, "fill": "$ink"}, {"type": "rectangle", "width": "fill_container", "height": 2, "fill": "$ink"}], "width": "fill_container", "height": 16, "alignItems": "center", "gap": 0}, {"type": "frame", "name": "Words", "children": [{"type": "text", "content": "Mixed and folded by hand", "fontFamily": "$font", "fontSize": 18, "fontWeight": "700", "fill": "$ink"}, {"type": "text", "content": "Wheat and wholegrain rye from Østfold, water, salt, and a starter we have fed every day since 2019.", "fontFamily": "$font", "fontSize": 16, "fontWeight": "400", "fill": "$ink-soft", "textGrowth": "fixed-width", "width": "fill_container", "lineHeight": 1.5}], "width": "fill_container", "layout": "vertical", "gap": 8, "padding": [0, 32, 0, 0]}],